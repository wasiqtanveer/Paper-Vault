  "repository": {
    "type": "git",
    "url": "https://github.com/wasiqtanveer/Paper-Vault.git"
  },
  "keywords": [
    "past-papers",
    "education",
    "react",
    "vite",
    "supabase"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
