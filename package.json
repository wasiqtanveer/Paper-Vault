{
  "name": "paper-vault",
  "private": true,
  "version": "1.0.0",
  "description": "A moderated vault of university past papers, tagged by subject, teacher, year, semester and exam type.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wasiqtanveer/Paper-Vault.git"
  },
  "keywords": [
    "past-papers",
    "education",
    "react",
    "vite",
    "supabase"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npx -p typescript tsc -p tsconfig.json",
    "db:verify": "bash scripts/db-verify.sh",
    "db:rls": "bash scripts/rls-regression.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/analytics": "^2.0.1",
    "browser-image-compression": "^2.0.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "supabase": "^3.2.0",
    "vite": "^8.3.8",
    "vitest": "^3.2.6"
  }
}
